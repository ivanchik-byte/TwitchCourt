# Copy nothing anywhere: export what you need, the rest stays in config.yaml.
# Every variable below overrides its config.yaml counterpart when set.

# LLM provider key (sets ai.api_key + ai.provider)
GROQ_API_KEY=
# CEREBRAS_API_KEY=

# Panel + WS action secret (sets server.secret)
TRIBUNAL_SECRET=

# DonationAlerts widget token (sets donations.token + donationalerts.token)
DONATE_TOKEN=
# DonatePay API key (sets donatepay.api_key)
DONATEPAY_API_KEY=

# Twitch IRC token, oauth:... with chat:read + chat:edit (sets twitch.token)
TWITCH_TOKEN=
