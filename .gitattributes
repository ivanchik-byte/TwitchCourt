# Enforce LF line endings across Linux and Windows
* text=auto eol=lf

*.go text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Windows batch files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.mp3 binary
*.wav binary
*.onnx binary
*.bin binary
*.pt binary
*.exe binary
*.dll binary
*.zip binary
